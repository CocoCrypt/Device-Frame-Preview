{
  "name": "ayzann-device-frame-preview",
  "displayName": "Device Frame Preview by AyZann",
  "description": "%description%",
  "version": "0.5.0",
  "publisher": "ayzann",
  "license": "MIT",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other",
    "Visualization"
  ],
  "keywords": [
    "mobile",
    "responsive",
    "preview",
    "device",
    "iphone",
    "android",
    "ipad",
    "tablet",
    "emulator",
    "simulator",
    "viewport",
    "live reload",
    "touch",
    "dark mode",
    "user agent",
    "breakpoints",
    "network throttling",
    "safe area"
  ],
  "main": "./extension.js",
  "activationEvents": [
    "onWebviewPanel:devicePreview"
  ],
  "contributes": {
    "commands": [
      {
        "command": "devicePreview.open",
        "title": "%command.open%",
        "icon": "$(device-mobile)"
      },
      {
        "command": "devicePreview.openFile",
        "title": "%command.openFile%",
        "icon": "$(device-mobile)"
      },
      {
        "command": "devicePreview.quickOpen",
        "title": "%command.quickOpen%"
      },
      {
        "command": "devicePreview.pickServer",
        "title": "%command.pickServer%",
        "icon": "$(server)"
      },
      {
        "command": "devicePreview.pickDevice",
        "title": "%command.pickDevice%",
        "icon": "$(search)"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "devicePreview.openFile",
          "when": "resourceExtname == .html || resourceExtname == .htm",
          "group": "navigation"
        }
      ],
      "explorer/context": [
        {
          "command": "devicePreview.openFile",
          "when": "resourceExtname == .html || resourceExtname == .htm",
          "group": "navigation"
        }
      ],
      "commandPalette": [
        {
          "command": "devicePreview.quickOpen",
          "when": "false"
        }
      ]
    },
    "configuration": {
      "title": "Device Frame Preview",
      "properties": {
        "devicePreview.defaultUrl": {
          "type": "string",
          "default": "http://localhost:3000",
          "description": "%config.defaultUrl%"
        },
        "devicePreview.defaultDevice": {
          "type": "string",
          "default": "iphone-15",
          "description": "%config.defaultDevice%"
        },
        "devicePreview.autoReload": {
          "type": "boolean",
          "default": true,
          "description": "%config.autoReload%"
        },
        "devicePreview.multiDevices": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "iphone-15",
            "ipad-air",
            "laptop-13"
          ],
          "description": "%config.multiDevices%"
        },
        "devicePreview.breakpoints": {
          "type": "array",
          "items": {
            "type": "number",
            "minimum": 100,
            "maximum": 4000
          },
          "default": [
            320,
            768,
            1024,
            1440
          ],
          "description": "%config.breakpoints%"
        },
        "devicePreview.customDevices": {
          "type": "array",
          "default": [],
          "description": "%config.customDevices%",
          "items": {
            "type": "object",
            "required": [
              "name",
              "width",
              "height"
            ],
            "properties": {
              "name": {
                "type": "string"
              },
              "width": {
                "type": "number",
                "description": "%config.customDevices.width%"
              },
              "height": {
                "type": "number",
                "description": "%config.customDevices.height%"
              },
              "type": {
                "type": "string",
                "enum": [
                  "phone",
                  "tablet",
                  "laptop"
                ],
                "default": "phone"
              },
              "notch": {
                "type": "boolean",
                "default": false
              },
              "userAgent": {
                "type": "string",
                "enum": [
                  "ios",
                  "ipados",
                  "android",
                  "android-tablet",
                  "none"
                ],
                "description": "%config.customDevices.userAgent%"
              }
            }
          }
        },
        "devicePreview.showStatusBar": {
          "type": "boolean",
          "default": true,
          "description": "%config.showStatusBar%"
        },
        "devicePreview.proxy": {
          "type": "boolean",
          "default": true,
          "description": "%config.proxy%"
        },
        "devicePreview.emulateUserAgent": {
          "type": "boolean",
          "default": true,
          "description": "%config.emulateUserAgent%"
        },
        "devicePreview.syncScroll": {
          "type": "boolean",
          "default": true,
          "description": "%config.syncScroll%"
        }
      }
    },
    "keybindings": [
      {
        "command": "devicePreview.quickOpen",
        "key": "ctrl+alt+p",
        "mac": "cmd+alt+p"
      }
    ]
  },
  "scripts": {
    "test": "node --test",
    "package": "npx --yes @vscode/vsce package -o ayzann-device-frame-preview.vsix",
    "install-ext": "npm run package && code --install-extension ayzann-device-frame-preview.vsix --force",
    "publish": "npx --yes @vscode/vsce publish",
    "publish:ovsx": "npx --yes ovsx publish ayzann-device-frame-preview.vsix"
  },
  "icon": "icon.png",
  "galleryBanner": {
    "color": "#1e1b4b",
    "theme": "dark"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/CocoCrypt/Device-Frame-Preview.git"
  },
  "bugs": {
    "url": "https://github.com/CocoCrypt/Device-Frame-Preview/issues"
  },
  "homepage": "https://github.com/CocoCrypt/Device-Frame-Preview#readme",
  "l10n": "./l10n"
}
