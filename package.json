            "iPad Pro 13\" (M4)",
            "iPad Pro 12,9\" / Air 13\"",
            "iPad Pro 11\" (M4)",
            "iPad Pro 11\" (2018-2022)",
            "iPad Air 11\" / iPad 10",
            "iPad 9 (10,2\")",
            "iPad mini (6th gen+)",
            "iPad classic / mini 5",
            "Galaxy Tab S9 Ultra",
            "Galaxy Tab S9",
            "Galaxy Tab A9+",
            "Google Pixel Tablet",
            "Surface Pro 7",
            "Kindle Fire HDX",
            "Google Nest Hub",
            "Google Nest Hub Max",
            "Laptop HD (1366×768)",
            "Laptop 13\" (1280×800)",
            "Laptop 1440×900",
            "Laptop 15\" (1536×864)",
            "Laptop Full HD (1920×1080)",
            "MacBook Air 13\"",
            "MacBook Air 15\"",
