{
  "name": "ayzann-device-frame-preview",
  "displayName": "Device Frame Preview by AyZann",
  "description": "%description%",
  "version": "0.5.2",
  "publisher": "ayzann",
  "license": "MIT",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other",
    "Visualization"
  ],
  "keywords": [
    "mobile",
    "responsive",
    "preview",
    "device",
    "iphone",
    "android",
    "ipad",
    "tablet",
    "emulator",
    "simulator",
    "viewport",
    "live reload",
    "touch",
    "dark mode",
    "user agent",
    "breakpoints",
    "network throttling",
    "safe area"
  ],
  "main": "./extension.js",
  "activationEvents": [
    "onWebviewPanel:devicePreview"
  ],
  "contributes": {
    "commands": [
      {
        "command": "devicePreview.open",
        "title": "%command.open%",
        "icon": "$(device-mobile)"
      },
      {
        "command": "devicePreview.openFile",
        "title": "%command.openFile%",
        "icon": "$(device-mobile)"
      },
      {
        "command": "devicePreview.quickOpen",
        "title": "%command.quickOpen%"
      },
      {
        "command": "devicePreview.pickServer",
        "title": "%command.pickServer%",
        "icon": "$(server)"
      },
      {
        "command": "devicePreview.pickDevice",
        "title": "%command.pickDevice%",
        "icon": "$(search)"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "devicePreview.openFile",
          "when": "resourceExtname == .html || resourceExtname == .htm",
          "group": "navigation"
        }
      ],
      "explorer/context": [
        {
          "command": "devicePreview.openFile",
          "when": "resourceExtname == .html || resourceExtname == .htm",
          "group": "navigation"
        }
      ],
      "commandPalette": [
        {
          "command": "devicePreview.quickOpen",
          "when": "false"
        }
      ]
    },
    "configuration": {
      "title": "Device Frame Preview",
      "properties": {
        "devicePreview.defaultUrl": {
          "type": "string",
          "default": "http://localhost:3000",
          "description": "%config.defaultUrl%"
        },
        "devicePreview.defaultDevice": {
          "type": "string",
          "default": "iphone-15",
          "description": "%config.defaultDevice%",
          "enum": [
            "iphone-17-pro-max",
            "iphone-17-pro",
            "iphone-air",
            "iphone-16-pro-max",
            "iphone-16-pro",
            "iphone-16-plus",
            "iphone-16",
            "iphone-16e",
            "iphone-15-max",
            "iphone-15",
            "iphone-14-plus",
            "iphone-14",
            "iphone-13-mini",
            "iphone-11",
            "iphone-x",
            "iphone-8-plus",
            "iphone-se",
            "iphone-5",
            "pixel-9-pro-xl",
            "pixel-9",
            "pixel-8",
            "pixel-7",
            "galaxy-s24-ultra",
            "galaxy-s24-plus",
            "galaxy-s24",
            "galaxy-s20-ultra",
            "galaxy-a55",
            "galaxy-a15",
            "galaxy-a51",
            "galaxy-s8",
            "xiaomi-14",
            "oneplus-12",
            "moto-g-power",
            "android-360",
            "android-small",
            "galaxy-fold",
            "galaxy-fold-open",
            "galaxy-flip",
            "pixel-fold",
            "surface-duo",
            "ipad-pro-13",
            "ipad-pro-12",
            "ipad-pro-11-m4",
            "ipad-pro-11",
            "ipad-air",
            "ipad-9",
            "ipad-mini",
            "ipad-classic",
            "galaxy-tab-s9-ultra",
            "galaxy-tab-s9",
            "galaxy-tab-a9",
            "pixel-tablet",
            "surface-pro",
            "kindle-fire",
            "nest-hub",
            "nest-hub-max",
            "laptop-hd",
            "laptop-13",
            "laptop-1440",
            "laptop-15",
            "laptop-fhd",
            "macbook-air-13",
            "macbook-air-15",
            "macbook-pro-14",
            "macbook-pro-16",
            "chromebook",
            "desktop-hd",
            "desktop-fhd",
            "desktop-qhd",
            "desktop-ultrawide",
            "imac-24"
          ],
          "enumItemLabels": [
            "iPhone 17 Pro Max",
            "iPhone 17 / 17 Pro",
            "iPhone Air",
            "iPhone 16 Pro Max",
            "iPhone 16 Pro",
            "iPhone 16 Plus",
            "iPhone 16",
            "iPhone 16e",
            "iPhone 15 Pro Max",
            "iPhone 15 / 15 Pro",
            "iPhone 14 Plus / 13 Pro Max",
            "iPhone 14 / 13 / 12",
            "iPhone 13 mini / 12 mini",
            "iPhone 11 / XR",
            "iPhone X / XS / 11 Pro",
            "iPhone 8 Plus",
            "iPhone SE / 8",
            "iPhone 5 / SE (1st gen)",
            "Google Pixel 9 Pro XL",
            "Google Pixel 9 / 9 Pro",
            "Google Pixel 8",
            "Google Pixel 7",
            "Samsung Galaxy S24 Ultra",
            "Samsung Galaxy S24+",
            "Samsung Galaxy S24 / S23",
            "Samsung Galaxy S20 Ultra",
